+def resolve_physical_device_ids(
+    cuda_visible_devices: Optional[str], device_count: int
+) -> List[int]:
+    """Map a full NVIDIA UUID mask to NVML indices without changing visibility.
+
+    Numeric masks, including the existing ROCm path, require no NVML access.
+    UUID handles are checked against the requested identity before their index
+    is used by the existing NVLink test. Lookup errors retain the normal
+    custom-allreduce initialization failure/fallback behavior.
+    """
+    if not cuda_visible_devices:
+        return list(range(device_count))
+    entries = [entry.strip() for entry in cuda_visible_devices.split(",")]
+    try:
+        return [int(entry) for entry in entries]
+    except ValueError:
+        if _is_hip:
+            raise ValueError("NVIDIA GPU UUID masks are unsupported on ROCm")
+    uuid_pattern = r"GPU-[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}"
+    for entry in entries:
+        if not re.fullmatch(uuid_pattern, entry):
+            try:
+                int(entry)
+            except ValueError as error:
+                raise ValueError(f"Expected a numeric device or full GPU UUID: {entry}") from error
+    pynvml.nvmlInit()
+    try:
+        physical_ids = []
+        for entry in entries:
+            if not entry.startswith("GPU-"):
+                physical_ids.append(int(entry))
+                continue
+            handle = pynvml.nvmlDeviceGetHandleByUUID(entry.encode("ascii"))
+            actual_uuid = pynvml.nvmlDeviceGetUUID(handle)
+            if isinstance(actual_uuid, bytes):
+                actual_uuid = actual_uuid.decode("ascii")
+            if actual_uuid.lower() != entry.lower():
+                raise ValueError(f"NVML UUID identity mismatch: requested {entry}, got {actual_uuid}")
+            physical_ids.append(int(pynvml.nvmlDeviceGetIndex(handle)))
+        return physical_ids
+    finally:
+        pynvml.nvmlShutdown()
+
+
